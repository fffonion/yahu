[Unit]
Description=Yet Another Hermes UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/yahu --host 127.0.0.1 --port 9642 --api-url http://127.0.0.1:8642 --workspace %h/workspace --hermes-home %h/.hermes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
