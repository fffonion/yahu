[Unit]
Description=Yet Another Hermes UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as an unprivileged user. Options:
#   - Set User= to the user who owns the Hermes installation (simplest)
#   - Or use DynamicUser=yes with ReadWritePaths= for a package deployment
User=nobody
Group=nogroup
# Paths below must be customized for your setup:
#   HERMES_HOME → Hermes data directory (optional; defaults to User's ~/.hermes)
#   --image-dir → image cache directory (optional)
Environment=HERMES_HOME=/var/lib/hermes
EnvironmentFile=/etc/yahu.env
ExecStart=/usr/local/bin/yahu --host 0.0.0.0 --port 9642 --api-url http://127.0.0.1:8642 --workspace /var/lib/hermes/workspace
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
